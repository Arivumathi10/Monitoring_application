# Copy to .env and fill in real values. Never commit .env.
# Generate a strong SECRET_KEY, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Login username (no default; must be set explicitly)
ADMIN_USERNAME=

# Store only a hash — never a plaintext password.
# Generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=

# Fernet key material for encrypting stored SSH passwords at rest.
# Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVERS_KEY=

# Optional path for encrypted server inventory JSON (mode 0600 recommended)
SERVERS_FILE=app/servers.json

# Optional: development | production (default: development)
FLASK_ENV=development
PORT=5013
